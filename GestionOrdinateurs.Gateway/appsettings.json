{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
    "ReverseProxy": {
    "Routes": {
      "ordinateurs-route": {
        "ClusterId": "gestion-api",
        "Match": {
          "Path": "/api/Ordinateurs/{**catch-all}"
        }
      },

      "reparations-route": {
        "ClusterId": "gestion-api",
        "Match": {
          "Path": "/api/Reparation/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "gestion-api": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5025/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
